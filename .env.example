# Copy to .env.local for local development. On Vercel set the same names
# under Project Settings > Environment Variables. NEVER commit real values.

# Google service account (Sheet must be shared with this email as Editor)
GOOGLE_SERVICE_ACCOUNT_EMAIL=dashboard@your-project.iam.gserviceaccount.com
# Paste the private_key from the JSON key. Keep the \n sequences, wrap in quotes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the Google Sheet URL: /spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=

# Logins
MASTER_PASSWORD=
VIEWER_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# ---- Data source: "sheets" (default) or "mysql" ----
DATA_SOURCE=mysql
# Either a single URL...
MYSQL_URL=
# ...or the separate parts (used when MYSQL_URL is empty)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Set to true for hosted databases that require TLS (PlanetScale, RDS, Aiven, ...)
MYSQL_SSL=false
